        {
            "name": "opencti_create_sighting",
            "label": "OpenCTI - Create Sighting",
            "description": "Create a Sighting in OpenCTI",
            "iconFileName": "alert_icon.png",
            "customScript": "alert_create_sighting_helper",
            "entity": [
                {
                    "type": "text",
                    "label": "Sighting of Value",
                    "field": "sighting_of_value",
                    "defaultValue": "",
                    "required": true
                },
                {
                    "type": "singleSelect",
                    "label": "Sighting of Type",
                    "field": "sighting_of_type",
                    "options": {
                        "items": [
                            {
                                "value": "indicator_id",
                                "label": "Indicator ID (STIX id of an existing indicator)"
                            },
                            {
                                "value": "url_indicator",
                                "label": "URL Indicator"
                            },
                            {
                                "value": "domain_indicator",
                                "label": "Domain Indicator"
                            },
                            {
                                "value": "ipv4_indicator",
                                "label": "IPV4 Indicator"
                            },
                            {
                                "value": "ipv6_indicator",
                                "label": "IPV6 Indicator"
                            },
                            {
                                "value": "file_hash_indicator",
                                "label": "File Hash Indicator (MD5, SHA-1, SHA-256, SHA-512)"
                            },
                            {
                                "value": "email_indicator",
                                "label": "Email Address Indicator"
                            },
                            {
                                "value": "url_observable",
                                "label": "URL Observable (legacy, sights the URL Indicator)"
                            },
                            {
                                "value": "domain_observable",
                                "label": "Domain Observable (legacy, sights the Domain Indicator)"
                            },
                            {
                                "value": "ipv4_observable",
                                "label": "IPV4 Observable (legacy, sights the IPV4 Indicator)"
                            },
                            {
                                "value": "ipv6_observable",
                                "label": "IPV6 Observable (legacy, sights the IPV6 Indicator)"
                            },
                            {
                                "value": "file_hash_observable",
                                "label": "File Hash Observable (legacy, sights the File Hash Indicator)"
                            }
                        ]
                    },
                    "help": "The sighting targets an OpenCTI indicator: by STIX id, or found or created from the value. Legacy Observable types sight the matching indicator and also send the observable. For File Hash, the algorithm is detected from the value",
                    "required": false,
                    "defaultValue": "domain_indicator"
                },
                {
                    "type": "text",
                    "label": "Count",
                    "field": "count",
                    "defaultValue": "1",
                    "required": false,
                    "help": "Number of times the value was seen (for example $result.count$)."
                },
                {
                    "type": "text",
                    "label": "Where Sighted (value)",
                    "field": "where_sighted_value",
                    "defaultValue": "",
                    "required": false,
                    "help": "Optional System or Organization where the value was sighted, in addition to the Splunk Security Platform"
                },
                {
                    "type": "singleSelect",
