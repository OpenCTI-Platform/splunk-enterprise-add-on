  "dataSources": {
    "ds_N5ccv7a7_ds_Pm9AHvFu_ds_hsDs3Q0C": {
      "name": "OpenCTI IOCs per indicator_type copy 1",
      "options": {
        "query": "| inputlookup opencti_indicators | stats count by indicator_types"
      },
      "type": "ds.search"
    },
    "ds_PA2GTclu_ds_hsDs3Q0C": {
      "name": "OpenCTI IOCs per markings",
      "options": {
        "query": "| inputlookup opencti_indicators | stats count by markings",
        "queryParameters": {
          "earliest": "$global_time.earliest$",
          "latest": "$global_time.latest$"
        }
      },
      "type": "ds.search"
    },
    "ds_PYxsaacd": {
      "name": "OpenCTI Indicators Count",
      "options": {
        "query": "| inputlookup opencti_indicators | stats count"
      },
      "type": "ds.search"
    },
    "ds_Pm9AHvFu_ds_hsDs3Q0C": {
      "name": "OpenCTI IOCs per indicator_type",
      "options": {
        "query": "| inputlookup opencti_indicators | stats count by indicator_types",
        "queryParameters": {
          "earliest": "$global_time.earliest$",
          "latest": "$global_time.latest$"
        }
      },
      "type": "ds.search"
    },
    "ds_R0rMZ4Ao": {
      "name": "OpenCTI Indicators per Labels",
      "options": {
        "query": "| inputlookup opencti_indicators | stats count by labels",
        "queryParameters": {
          "earliest": "$global_time.earliest$",
          "latest": "$global_time.latest$"
        }
      },
      "type": "ds.search"
    },
    "ds_YI12Xgn7": {
      "name": "OpenCTI added IOCs over time",
      "options": {
        "query": "| inputlookup opencti_indicators | eval added_at = coalesce(strptime(added_at, \"%Y-%m-%dT%H:%M:%S.%3NZ\"), strptime(added_at, \"%Y-%m-%dT%H:%M:%SZ\")) | eval _time = added_at | timechart count AS Count",
        "queryParameters": {
          "earliest": "$global_time.earliest$",
          "latest": "$global_time.latest$"
        }
      },
      "type": "ds.search"
    },
    "ds_hsDs3Q0C": {
      "name": "OpenCTI IOCs per type",
      "options": {
        "query": "| inputlookup opencti_indicators | stats count by type",
        "queryParameters": {
          "earliest": "$global_time.earliest$",
          "latest": "$global_time.latest$"
        }
      },
      "type": "ds.search"
    },
    "ds_nbAJEARh_ds_Pm9AHvFu_ds_hsDs3Q0C": {
      "name": "OpenCTI IOCs per score",
      "options": {
        "query": "| inputlookup opencti_indicators | stats count by score",
        "queryParameters": {
          "earliest": "$global_time.earliest$",
          "latest": "$global_time.latest$"
        }
      },
      "type": "ds.search"
    },
    "ds_tR29ZhaJ_ds_PA2GTclu_ds_hsDs3Q0C": {
      "name": "OpenCTI IOCs per Creator",
      "options": {
        "query": "| inputlookup opencti_indicators | stats count by created_by",
        "queryParameters": {
          "earliest": "$global_time.earliest$",
          "latest": "$global_time.latest$"
        }
      },
      "type": "ds.search"
    },
    "ds_z5ZhhLJx_ds_PYxsaacd": {
      "name": "OpenCTI Indicators Revoked",
      "options": {
        "query": "| inputlookup opencti_indicators | stats by revoked",
        "queryParameters": {}
      },
      "type": "ds.search"
    },
    "ds_dep_status": {
      "name": "Deployments by status",
      "options": {
        "query": "| inputlookup opencti_deployments | stats count by status | rename status AS deployment_status",
        "queryParameters": {}
      },
      "type": "ds.search"
    },
    "ds_dep_failures_count": {
      "name": "Failed deployments",
      "options": {
        "query": "| inputlookup opencti_deployments | where result=\"error\" OR status=\"failed\" | stats count",
        "queryParameters": {}
      },
      "type": "ds.search"
    },
    "ds_dep_last_sync": {
      "name": "Last sync",
      "options": {
        "query": "| inputlookup opencti_deployments | eval t=coalesce(strptime(reported_at, \"%Y-%m-%dT%H:%M:%S.%3NZ\"), strptime(reported_at, \"%Y-%m-%dT%H:%M:%SZ\")) | stats max(t) AS last | eval last_sync=strftime(last, \"%Y-%m-%d %H:%M:%S UTC\") | fields last_sync",
        "queryParameters": {}
      },
      "type": "ds.search"
    },
    "ds_val_outcomes": {
      "name": "Validation statuses",
      "options": {
        "query": "| inputlookup opencti_validation_results | stats count by outcome | rename outcome AS validation_status",
        "queryParameters": {}
      },
      "type": "ds.search"
    },
    "ds_dep_failures": {
      "name": "Failed deployments (latest)",
      "options": {
        "query": "| inputlookup opencti_deployments | where result=\"error\" OR status=\"failed\" | lookup opencti_indicators id AS indicator_id OUTPUT value type | sort - reported_at | head 100 | rename status AS deployment_status | table reported_at indicator_id value type deployment_status error",
        "queryParameters": {}
      },
      "type": "ds.search"
    },
    "ds_hits_top": {
      "name": "Most hit indicators",
      "options": {
        "query": "| inputlookup opencti_indicator_hits | sort - hit_count | head 20 | table value type hit_count first_hit last_hit last_status indicator_id",
        "queryParameters": {}
      },
      "type": "ds.search"
    },
    "ds_hits_daily": {
      "name": "Indicators hit per day (last hit)",
      "options": {
        "query": "| inputlookup opencti_indicator_hits | eval _time=coalesce(strptime(last_hit, \"%Y-%m-%dT%H:%M:%S.%3NZ\"), strptime(last_hit, \"%Y-%m-%dT%H:%M:%SZ\")) | where _time >= relative_time(now(), \"-30d@d\") | timechart span=1d count AS indicators_hit",
        "queryParameters": {}
      },
      "type": "ds.search"
    },
    "ds_val_latest": {
      "name": "Latest validations",
      "options": {
        "query": "| inputlookup opencti_validation_results | sort - decided_at | head 100 | rename outcome AS validation_status | table decided_at request_name value test_kind validation_status first_matching_hit channel",
        "queryParameters": {}
      },
      "type": "ds.search"
    },
    "ds_writeback_errors": {
      "name": "Write-back errors and warnings",
      "options": {
        "query": "index=_internal sourcetype=\"taopenctiforsplunkenterprise:log\" (\"Deployment write-back\" OR \"Hit report\" OR \"IOC validation\" OR \"provides\" OR \"Security Platform\") (ERROR OR WARNING) | head 100 | table _time source _raw"
      },
      "type": "ds.search"
    },
    "ds_kn_corroboration": {
      "name": "Indicators by number of sources",
      "options": {
        "query": "| inputlookup opencti_indicators | where isnotnull(corroboration_count) | stats count by corroboration_count | sort corroboration_count",
        "queryParameters": {}
      },
      "type": "ds.search"
    },
    "ds_kn_sourcing": {
      "name": "Single-sourced indicators",
      "options": {
        "query": "| inputlookup opencti_indicators | where isnotnull(corroboration_count) | eval single_sourced=if(match(lower(tostring(single_sourced)), \"^(1|true)$\"), \"true\", \"false\") | stats count by single_sourced",
        "queryParameters": {}
      },
      "type": "ds.search"
    },
    "ds_kn_stale": {
      "name": "Stale indicators",
      "options": {
        "query": "| inputlookup opencti_indicators | where isnotnull(corroboration_count) | eval freshness_stale=if(match(lower(tostring(freshness_stale)), \"^(1|true)$\"), \"true\", \"false\") | stats count by freshness_stale",
        "queryParameters": {}
      },
      "type": "ds.search"
    },
    "ds_kn_top": {
      "name": "Most corroborated indicators",
      "options": {
        "query": "| inputlookup opencti_indicators | where isnotnull(corroboration_count) | sort - corroboration_count | head 50 | table value type corroboration_count sources sources_by_kind last_asserted_at single_sourced",
        "queryParameters": {}
      },
      "type": "ds.search"
    },
    "ds_kn_prevalence": {
      "name": "Prevalence",
      "options": {
        "query": "| inputlookup opencti_indicators | where isnotnull(pulse_prevalence) | eval pulse_prevalence=if(match(lower(tostring(pulse_preview)), \"^(1|true)$\"), pulse_prevalence.\" (preview)\", pulse_prevalence) | stats count by pulse_prevalence",
        "queryParameters": {}
      },
      "type": "ds.search"
    },
    "ds_kn_trend": {
      "name": "Trend",
      "options": {
        "query": "| inputlookup opencti_indicators | where isnotnull(pulse_trend) | eval pulse_trend=if(match(lower(tostring(pulse_preview)), \"^(1|true)$\"), pulse_trend.\" (preview)\", pulse_trend) | stats count by pulse_trend",
        "queryParameters": {}
      },
      "type": "ds.search"
    },
    "ds_kn_rising": {
      "name": "Rising indicators",
      "options": {
        "query": "| inputlookup opencti_indicators | where pulse_trend=\"rising\" | sort - score | head 50 | eval pulse_data=if(match(lower(tostring(pulse_preview)), \"^(1|true)$\"), \"preview\", \"full\") | table value type score pulse_prevalence pulse_trend pulse_data pulse_first_seen_network pulse_platforms_bucket",
        "queryParameters": {}
      },
      "type": "ds.search"
    },
    "ds_df_declared": {
      "name": "Data components declared (provides)",
      "options": {
        "query": "| inputlookup opencti_provides | where status=\"declared\" | stats dc(data_component) AS declared",
        "queryParameters": {}
      },
      "type": "ds.search"
    },
    "ds_df_inventory": {
      "name": "Telemetry inventory",
      "options": {
        "query": "| inputlookup opencti_provides | sort data_component | table data_component status event_count sources reported_at",
        "queryParameters": {}
      },
      "type": "ds.search"
    },
    "ds_hunt_evidence": {
      "name": "Hunt evidence",
      "options": {
        "query": "index=_internal sourcetype=\"taopenctiforsplunkenterprise:log\" source=\"*opencti_report_hunt_evidence_modalert.log*\" \"Hunt evidence for run\" | rex \"Hunt evidence for run (?<hunt_run_id>\\S+) \\((?<hunt>.*?)\\) sent: (?<objects>\\d+) objects, (?<targets>\\d+) hunt targets\" | table _time hunt_run_id hunt objects targets"
      },
      "type": "ds.search"
    },
    "ds_hunt_errors": {
      "name": "Hunt evidence errors",
      "options": {
        "query": "index=_internal sourcetype=\"taopenctiforsplunkenterprise:log\" source=\"*opencti_report_hunt_evidence_modalert.log*\" (ERROR OR WARNING) | head 100 | table _time _raw"
      },
      "type": "ds.search"
    },
    "ds_tl_milestones": {
      "name": "Timeline milestones",
      "options": {
        "query": "index=_internal sourcetype=\"taopenctiforsplunkenterprise:log\" \"Timeline milestone added on\" | rex \"Timeline milestone added on (?<container_id>\\S+)\" | table _time source container_id"
      },
      "type": "ds.search"
    },
    "ds_tl_autopilot": {
      "name": "Case Autopilot runs",
      "options": {
        "query": "index=_internal sourcetype=\"taopenctiforsplunkenterprise:log\" \"Case Autopilot run\" \"started for\" | rex \"Case Autopilot run (?<run_id>\\S+) started for (?<container_id>\\S+)\" | table _time source run_id container_id"
      },
      "type": "ds.search"
    }
  },
