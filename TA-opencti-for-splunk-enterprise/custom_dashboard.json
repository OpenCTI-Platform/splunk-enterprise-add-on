  "dataSources": {
    "ds_N5ccv7a7_ds_Pm9AHvFu_ds_hsDs3Q0C": {
      "name": "OpenCTI IOCs per indicator_type copy 1",
      "options": {
        "query": "| inputlookup opencti_indicators | stats count by indicator_types"
      },
      "type": "ds.search"
    },
    "ds_PA2GTclu_ds_hsDs3Q0C": {
      "name": "OpenCTI IOCs per markings",
      "options": {
        "query": "| inputlookup opencti_indicators | stats count by markings",
        "queryParameters": {
          "earliest": "$global_time.earliest$",
          "latest": "$global_time.latest$"
        }
      },
      "type": "ds.search"
    },
    "ds_PYxsaacd": {
      "name": "OpenCTI Indicators Count",
      "options": {
        "query": "| inputlookup opencti_indicators | stats count"
      },
      "type": "ds.search"
    },
    "ds_Pm9AHvFu_ds_hsDs3Q0C": {
      "name": "OpenCTI IOCs per indicator_type",
      "options": {
        "query": "| inputlookup opencti_indicators | stats count by indicator_types",
        "queryParameters": {
          "earliest": "$global_time.earliest$",
          "latest": "$global_time.latest$"
        }
      },
      "type": "ds.search"
    },
    "ds_R0rMZ4Ao": {
      "name": "OpenCTI Indicators per Labels",
      "options": {
        "query": "| inputlookup opencti_indicators | stats count by labels",
        "queryParameters": {
          "earliest": "$global_time.earliest$",
          "latest": "$global_time.latest$"
        }
      },
      "type": "ds.search"
    },
    "ds_YI12Xgn7": {
      "name": "OpenCTI added IOCs over time",
      "options": {
        "query": "| inputlookup opencti_indicators | eval added_at = strptime(added_at, \"%Y-%m-%dT%H:%M:%SZ\") | eval _time = added_at | timechart count AS Count",
        "queryParameters": {
          "earliest": "$global_time.earliest$",
          "latest": "$global_time.latest$"
        }
      },
      "type": "ds.search"
    },
    "ds_hsDs3Q0C": {
      "name": "OpenCTI IOCs per type",
      "options": {
        "query": "| inputlookup opencti_indicators | stats count by type",
        "queryParameters": {
          "earliest": "$global_time.earliest$",
          "latest": "$global_time.latest$"
        }
      },
      "type": "ds.search"
    },
    "ds_nbAJEARh_ds_Pm9AHvFu_ds_hsDs3Q0C": {
      "name": "OpenCTI IOCs per score",
      "options": {
        "query": "| inputlookup opencti_indicators | stats count by score",
        "queryParameters": {
          "earliest": "$global_time.earliest$",
          "latest": "$global_time.latest$"
        }
      },
      "type": "ds.search"
    },
    "ds_tR29ZhaJ_ds_PA2GTclu_ds_hsDs3Q0C": {
      "name": "OpenCTI IOCs per Creator",
      "options": {
        "query": "| inputlookup opencti_indicators | stats count by created_by",
        "queryParameters": {
          "earliest": "$global_time.earliest$",
          "latest": "$global_time.latest$"
        }
      },
      "type": "ds.search"
    },
    "ds_z5ZhhLJx_ds_PYxsaacd": {
      "name": "OpenCTI Indicators Revoked",
      "options": {
        "query": "| inputlookup opencti_indicators | stats by revoked",
        "queryParameters": {}
      },
      "type": "ds.search"
    },
    "ds_dep_status": {
      "name": "Deployments by status",
      "options": {
        "query": "| inputlookup opencti_deployments | stats count by status | rename status AS deployment_status",
        "queryParameters": {}
      },
      "type": "ds.search"
    },
    "ds_dep_failures_count": {
      "name": "Failed deployments",
      "options": {
        "query": "| inputlookup opencti_deployments | where result=\"error\" OR status=\"failed\" | stats count",
        "queryParameters": {}
      },
      "type": "ds.search"
    },
    "ds_dep_last_sync": {
      "name": "Last sync",
      "options": {
        "query": "| inputlookup opencti_deployments | eval t=coalesce(strptime(reported_at, \"%Y-%m-%dT%H:%M:%S.%3NZ\"), strptime(reported_at, \"%Y-%m-%dT%H:%M:%SZ\")) | stats max(t) AS last | eval last_sync=strftime(last, \"%Y-%m-%d %H:%M:%S UTC\") | fields last_sync",
        "queryParameters": {}
      },
      "type": "ds.search"
    },
    "ds_val_outcomes": {
      "name": "Validation statuses",
      "options": {
        "query": "| inputlookup opencti_validation_results | stats count by outcome | rename outcome AS validation_status",
        "queryParameters": {}
      },
      "type": "ds.search"
    },
    "ds_dep_failures": {
      "name": "Failed deployments (latest)",
      "options": {
        "query": "| inputlookup opencti_deployments | where result=\"error\" OR status=\"failed\" | lookup opencti_indicators id AS indicator_id OUTPUT value type | sort - reported_at | head 100 | eval value = coalesce(value, \"(indicator not in Splunk)\"), status = case(status==\"deployed\", \"Deployed\", status==\"removed\", \"Removed\", status==\"failed\", \"Failed\", status==\"expired\", \"Expired\", true(), status) | table reported_at value type status error | rename reported_at AS \"Reported at\", value AS \"Value\", type AS \"Type\", status AS \"Status\", error AS \"Error\"",
        "queryParameters": {}
      },
      "type": "ds.search"
    },
    "ds_hits_top": {
      "name": "Most hit indicators",
      "options": {
        "query": "| inputlookup opencti_indicator_hits | sort - hit_count | head 20 | eval first_hit = replace(first_hit, \"\\.\\d+Z$\", \"Z\"), last_hit = replace(last_hit, \"\\.\\d+Z$\", \"Z\"), last_status = case(last_status==\"reported\", \"Reported\", last_status==\"reported_as_sighting\", \"Reported as a sighting\", true(), last_status) | table value type hit_count first_hit last_hit last_status | rename value AS \"Value\", type AS \"Type\", hit_count AS \"Hits\", first_hit AS \"First hit\", last_hit AS \"Last hit\", last_status AS \"Last status\"",
        "queryParameters": {}
      },
      "type": "ds.search"
    },
    "ds_hits_daily": {
      "name": "Indicators hit per day (last hit)",
      "options": {
        "query": "| inputlookup opencti_indicator_hits | eval _time=coalesce(strptime(last_hit, \"%Y-%m-%dT%H:%M:%S.%3NZ\"), strptime(last_hit, \"%Y-%m-%dT%H:%M:%SZ\")) | where _time >= relative_time(now(), \"-30d@d\") | timechart span=1d count AS indicators_hit",
        "queryParameters": {}
      },
      "type": "ds.search"
    },
    "ds_val_latest": {
      "name": "Latest validations",
      "options": {
        "query": "| inputlookup opencti_validation_results | sort - decided_at | head 100 | eval test_kind = case(test_kind==\"dns_resolution\", \"DNS resolution\", test_kind==\"http_head\", \"HTTP HEAD through the egress proxy\", test_kind==\"network_traffic\", \"Network connection (safe mode)\", test_kind==\"file_drop\", \"Benign file surrogate\", test_kind==\"log_injection\", \"Log injection\", true(), replace(test_kind, \"_\", \" \")), first_matching_hit = replace(first_matching_hit, \"\\.\\d+Z$\", \"Z\"), outcome = case(outcome==\"detected\", \"Detected\", outcome==\"missed\", \"Missed\", outcome==\"requested\", \"Waiting\", true(), outcome), channel = case(channel==\"iocValidationReportResults\", \"Validation results\", channel==\"bundle\", \"Sighting bundle\", isnull(channel) OR channel==\"\", \"Not reported\", true(), channel) | table decided_at request_name value test_kind outcome first_matching_hit channel | rename decided_at AS \"Decided at\", request_name AS \"Request\", value AS \"Value\", test_kind AS \"Test\", outcome AS \"Outcome\", first_matching_hit AS \"First matching hit\", channel AS \"Channel\"",
        "queryParameters": {}
      },
      "type": "ds.search"
    },
    "ds_writeback_errors": {
      "name": "Write-back errors and warnings",
      "options": {
        "query": "index=_internal sourcetype=\"taopenctiforsplunkenterprise:log\" (\"Deployment write-back\" OR \"Hit report\" OR \"IOC validation\" OR \"Security Platform\") (ERROR OR WARNING) | head 100 | table _time source _raw"
      },
      "type": "ds.search"
    }
  },
